#!/usr/bin/env bash
# Opt-in recovery for Codex conversations in tmux panes.  See docs/codex-restore.md.
set -euo pipefail

STATE_DIR="${CODEX_RESTORE_HOME:-$HOME/.local/state/codex-restore}"
ENTRIES="$STATE_DIR/entries"
MANAGED="$STATE_DIR/managed-panes"
LOCKS="$STATE_DIR/locks"
LABEL="com.jasonalvarez.codex-restore-wezterm"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

usage() {
  cat <<'EOF'
Usage: codex-restore <command> [arguments]

  start [codex arguments...]  Run a Codex session in this pane and record it for recovery.
  unmanage                   Stop recording future Codex sessions in this pane.
  list                       Show recoverable sessions and their saved pane locations.
  restore [--yes]            Resume saved sessions in matching restored panes.
  forget <session-id>        Remove a saved session and its restore lock.
  install-login              Open WezTerm once after graphical login.
  uninstall-login            Remove the login-time WezTerm launcher.
  capture <session-id>       Hook-only: record a managed pane's Codex session.
EOF
}

die() { printf 'codex-restore: %s\n' "$*" >&2; exit 2; }
note() { printf 'codex-restore: %s\n' "$*" >&2; }

init_state() {
  umask 077
  mkdir -p "$ENTRIES" "$MANAGED" "$LOCKS"
  chmod 700 "$STATE_DIR" "$ENTRIES" "$MANAGED" "$LOCKS" 2>/dev/null || true
}

pane_key() { printf '%s' "${1#%}"; }
valid_session_id() { [[ "$1" =~ ^[0-9a-fA-F-]{16,}$ ]]; }
field() { sed -n "s/^$2=//p" "$1" | head -n 1; }
current_server_id() { tmux display-message -p '#{pid}' 2>/dev/null || true; }

current_pane_field() {
  local format="$1"
  tmux display-message -p -t "${TMUX_PANE:?not running inside tmux}" "$format"
}

managed_marker() { printf '%s/%s' "$MANAGED" "$(pane_key "${TMUX_PANE:-}")"; }

same_logical_pane() {
  local file="$1" session="$2" window="$3" pane="$4" cwd="$5"
  [[ "$(field "$file" tmux_session)" == "$session" ]] &&
    [[ "$(field "$file" window_index)" == "$window" ]] &&
    [[ "$(field "$file" pane_index)" == "$pane" ]] &&
    [[ "$(field "$file" cwd)" == "$cwd" ]]
}

remove_old_identity() {
  local session="$1" window="$2" pane="$3" cwd="$4" entry old_id
  for entry in "$ENTRIES"/*; do
    [[ -f "$entry" ]] || continue
    if same_logical_pane "$entry" "$session" "$window" "$pane" "$cwd"; then
      old_id="$(field "$entry" session_id)"
      rm -f "$entry" "$LOCKS/$old_id"
    fi
  done
}

capture() {
  local session_id="${1:-}" marker session window pane cwd tmp
  valid_session_id "$session_id" || exit 0
  [[ -n "${TMUX_PANE:-}" ]] || exit 0
  init_state
  marker="$(managed_marker)"
  [[ -f "$marker" ]] || exit 0

  session="$(current_pane_field '#{session_name}')"
  window="$(current_pane_field '#{window_index}')"
  pane="$(current_pane_field '#{pane_index}')"
  cwd="$(current_pane_field '#{pane_current_path}')"
  # The line-oriented registry intentionally rejects paths it cannot round-trip.
  [[ "$session$window$pane$cwd" != *$'\n'* && "$session$window$pane$cwd" != *$'\t'* ]] || {
    note 'not recording a pane whose identity contains a tab or newline'
    exit 0
  }

  remove_old_identity "$session" "$window" "$pane" "$cwd"
  tmp="$(mktemp "$ENTRIES/.tmp.XXXXXX")"
  {
    printf 'session_id=%s\n' "$session_id"
    printf 'tmux_session=%s\n' "$session"
    printf 'window_index=%s\n' "$window"
    printf 'pane_index=%s\n' "$pane"
    printf 'cwd=%s\n' "$cwd"
    printf 'recorded_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ENTRIES/$session_id"
}

start() {
  [[ -n "${TMUX_PANE:-}" ]] || die 'start must be run from a tmux pane'
  init_state
  : >"$(managed_marker)"
  trap 'rm -f "$(managed_marker)"' EXIT
  command codex "$@"
}

unmanage() {
  [[ -n "${TMUX_PANE:-}" ]] || die 'unmanage must be run from a tmux pane'
  init_state
  rm -f "$(managed_marker)"
  note 'future Codex sessions in this pane will not be recorded; existing entries remain until forgotten.'
}

list_entries() {
  local entry
  init_state
  for entry in "$ENTRIES"/*; do
    [[ -f "$entry" ]] || continue
    printf '%s\t%s:%s.%s\t%s\t%s\n' \
      "$(field "$entry" session_id)" \
      "$(field "$entry" tmux_session)" \
      "$(field "$entry" window_index)" \
      "$(field "$entry" pane_index)" \
      "$(field "$entry" cwd)" \
      "$(field "$entry" recorded_at)"
  done
}

pane_for_entry() {
  local entry="$1" session window pane cwd line found=""
  session="$(field "$entry" tmux_session)"
  window="$(field "$entry" window_index)"
  pane="$(field "$entry" pane_index)"
  cwd="$(field "$entry" cwd)"
  while IFS=$'\t' read -r got_session got_window got_pane got_id got_cwd; do
    [[ "$got_session" == "$session" && "$got_window" == "$window" && "$got_pane" == "$pane" && "$got_cwd" == "$cwd" ]] || continue
    [[ -z "$found" ]] || return 1
    found="$got_id"
  done < <(tmux list-panes -a -F $'#{session_name}\t#{window_index}\t#{pane_index}\t#{pane_id}\t#{pane_current_path}')
  [[ -n "$found" ]] && printf '%s' "$found"
}

lock_allows() {
  local session_id="$1" server="$2" lock="$LOCKS/$session_id"
  if [[ -f "$lock" ]] && [[ "$(field "$lock" tmux_server)" == "$server" ]]; then
    return 1
  fi
  printf 'tmux_server=%s\nstarted_at=%s\n' "$server" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$lock"
}

restore() {
  local auto="false" entry session_id pane_id server candidates=0 resumed=0
  [[ "${1:-}" == "--yes" || -z "${1:-}" ]] || die 'restore accepts only --yes'
  [[ "${1:-}" == "--yes" ]] && auto="true"
  init_state
  server="$(current_server_id)"
  [[ -n "$server" ]] || die 'no tmux server is running'

  for entry in "$ENTRIES"/*; do
    [[ -f "$entry" ]] || continue
    pane_id="$(pane_for_entry "$entry" || true)"
    [[ -n "$pane_id" ]] || continue
    candidates=$((candidates + 1))
    printf '%s -> %s (%s)\n' "$(field "$entry" session_id)" "$pane_id" "$(field "$entry" cwd)"
  done
  (( candidates > 0 )) || { note 'no saved sessions match restored panes'; return 0; }

  if [[ "$auto" != "true" ]]; then
    [[ -t 0 ]] || die 'confirmation requires a terminal; rerun with --yes after reviewing candidates'
    printf 'Resume %d managed Codex pane(s)? [y/N] ' "$candidates" >&2
    read -r reply
    [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]] || { note 'cancelled'; return 0; }
  fi

  for entry in "$ENTRIES"/*; do
    [[ -f "$entry" ]] || continue
    session_id="$(field "$entry" session_id)"
    pane_id="$(pane_for_entry "$entry" || true)"
    [[ -n "$pane_id" ]] || continue
    if ! lock_allows "$session_id" "$server"; then
      note "skipping $session_id: it was already resumed in this tmux server"
      continue
    fi
    tmux send-keys -t "$pane_id" "codex resume $session_id" C-m
    resumed=$((resumed + 1))
  done
  note "sent resume commands to $resumed pane(s); reconcile interrupted work before retrying commands."
}

forget() {
  local session_id="${1:-}"
  valid_session_id "$session_id" || die 'forget requires a Codex session UUID'
  init_state
  rm -f "$ENTRIES/$session_id" "$LOCKS/$session_id"
}

install_login() {
  init_state
  mkdir -p "$HOME/Library/LaunchAgents"
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>/usr/bin/open</string><string>-a</string><string>WezTerm</string></array>
  <key>RunAtLoad</key><true/>
</dict></plist>
EOF
  chmod 600 "$PLIST"
  plutil -lint "$PLIST" >/dev/null
  launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  note "installed $PLIST (WezTerm opens after graphical login)"
}

uninstall_login() {
  launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
  rm -f "$PLIST"
  note 'removed the login-time WezTerm launcher'
}

case "${1:-}" in
  start) shift; start "$@" ;;
  unmanage) unmanage ;;
  list) list_entries ;;
  restore) shift; restore "${1:-}" ;;
  forget) forget "${2:-}" ;;
  install-login) install_login ;;
  uninstall-login) uninstall_login ;;
  capture) capture "${2:-}" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
