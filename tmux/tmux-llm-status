#!/usr/bin/env bash
set -euo pipefail

tmux_cmd() {
  local default_socket
  default_socket="/private/tmp/tmux-$(id -u)/default"
  local tmux_bin="tmux"

  if [[ -x "/opt/homebrew/bin/tmux" ]]; then
    tmux_bin="/opt/homebrew/bin/tmux"
  elif [[ -x "/usr/local/bin/tmux" ]]; then
    tmux_bin="/usr/local/bin/tmux"
  fi

  if [[ -n "${TMUX_SOCKET:-}" ]]; then
    "$tmux_bin" -S "$TMUX_SOCKET" "$@"
  elif [[ -S "$default_socket" ]]; then
    "$tmux_bin" -S "$default_socket" "$@"
  else
    "$tmux_bin" "$@"
  fi
}

# LLM PRESENCE is detected from the terminal title (see the title helpers below
# and the classification order in count_window); WORKING is not, because Claude
# Code 2.1.2xx stopped animating its title - it now shows a static "✳ <summary>"
# whether it is thinking or idle, and ships no braille frames at all. Working
# state therefore comes from the hook-published busy marker (is_pane_busy); the
# title matchers survive only for Codex and any CLI that still animates.
# pane_current_command is an unstable value (Claude reports a version string such
# as "2.1.198", not "claude"), so presence is matched by title, not command. This
# list is only a fallback for CLIs that expose a stable process name. Do NOT add
# version strings here - fix the title matchers instead.
is_llm_command() {
  case "$1" in
    codex | claude | gemini | aider | opencode)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

STATE_HOME="${TMUX_LLM_STATE_HOME:-${HOME:-}/.local/state/tmux-llm}"

# How long a busy marker stays believable without a heartbeat. `Stop` does not
# fire when you interrupt a turn, so freshness - not mere existence - is what
# keeps an abandoned marker from spinning forever. The floor is the longest gap
# the hook can go without refreshing, i.e. one tool batch.
BUSY_TTL="${TMUX_LLM_BUSY_TTL:-1200}"

# Set once per pass and reused: this runs for every pane every second, so the
# alternative is a `date` fork per pane.
refresh_now() { NOW="$(date +%s)"; }

# Is a turn running in this pane? The marker holds the epoch of the last hook
# event in the turn. Read with a redirect rather than $(cat ...) to stay
# fork-free on the per-pane path.
is_pane_busy() {
  local file="$STATE_HOME/panes/${1#%}.busy" stamp=''
  [[ -f "$file" ]] || return 1
  [[ -n "${NOW:-}" ]] || refresh_now
  read -r stamp < "$file" 2>/dev/null || true
  [[ "$stamp" =~ ^[0-9]+$ ]] || return 1
  (( NOW - stamp < BUSY_TTL ))
}

# Parked on a permission or question prompt? No TTL on purpose: a prompt can wait
# all night, and the next thing you type in that pane clears it.
is_pane_blocked() { [[ -f "$STATE_HOME/panes/${1#%}.needs" ]]; }

# A bare shell means the agent is gone (crashed or killed mid-prompt), so any
# leftover .needs there is stale.
is_shell_command() {
  case "${1#-}" in zsh | bash | sh | fish | dash | ksh | tcsh) return 0 ;; *) return 1 ;; esac
}

# In-flight subagents for one pane, as a file count published by the
# tmux-agent-depth hook. Globbed rather than `ls`, and assigns into AGENT_COUNT
# rather than printing, because this runs for every pane on every one-second
# pass and must not fork - `$(...)` at the call site would fork just as surely
# as `ls` would.
count_agents() {
  local dir="$STATE_HOME/panes/${1#%}.agents"
  local -a found=("$dir"/*)
  if [[ -e "${found[0]}" ]]; then AGENT_COUNT=${#found[@]}; else AGENT_COUNT=0; fi
}

# Drop agent and busy state for panes tmux no longer reports. Pane ids reset to
# %0 on a tmux server restart, so stale state could otherwise collide with a
# recycled id.
prune_dead_panes() {
  local entry id live
  [[ -d "$STATE_HOME/panes" ]] || return 0
  live=" $(tmux_cmd list-panes -a -F '#{pane_id}' 2>/dev/null | tr -d '%' | tr '\n' ' ' || true)"
  # An empty live set more likely means the socket resolved wrong than that every
  # pane died at once - never let that wipe valid state.
  [[ "$live" != " " ]] || return 0
  for entry in "$STATE_HOME/panes"/*.agents "$STATE_HOME/panes"/*.busy "$STATE_HOME/panes"/*.meta "$STATE_HOME/panes"/*.needs; do
    [[ -e "$entry" ]] || continue
    id="${entry##*/}"
    id="${id%.agents}"
    id="${id%.busy}"
    id="${id%.meta}"
    id="${id%.needs}"
    case "$live" in
      *" $id "*) ;;
      *) rm -rf "$entry" 2>/dev/null || true ;;
    esac
  done
}

has_spinner_title() {
  case "$1" in
    # Braille spinner frames (U+2800-U+28FF). Claude Code animates the terminal
    # title with braille dots while actively working, and the classic dot
    # spinner lives in the same block. Matching the UTF-8 byte prefixes (E2 A0
    # through E2 A3) covers every frame without depending on which one is shown.
    $'\xe2\xa0'* | $'\xe2\xa1'* | $'\xe2\xa2'* | $'\xe2\xa3'*)
      return 0
      ;;
    # Circle / ASCII spinners (glyph followed by a space).
    "◐ "* | "◓ "* | "◑ "* | "◒ "* | "- "* | "\\ "* | "| "* | "/ "*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

spinner_frame() {
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  local index
  index=$(($(date +%s) % ${#frames[@]}))
  printf '%s' "${frames[$index]}"
}

is_codex_title() {
  [[ "$1" == \[*\]\ *\|* ]]
}

is_claude_title() {
  # Claude Code shows a static "✳ " prefix (U+2733) while present but idle /
  # awaiting input. The animated braille frames (handled by has_spinner_title)
  # cover the actively-working state.
  case "$1" in
    "✳ "* | "✳"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_waiting_title() {
  case "$1" in
    *"Action Required"* | *"Ready"* | *"Idle"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_active_title() {
  case "$1" in
    *"Thinking"* | *"Working"* | *"Running"* | *"Processing"* | *"Executing"* | *"Loading"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# One pane's state into PANE_STATE (waiting|active|present|none), plus AGENT_COUNT.
# Shared by the status bar and the table so the two can never disagree.
classify_pane() {
  local pane_id="$1" command="$2" title="$3"
  count_agents "$pane_id"
  # A blocked prompt outranks every working signal: the turn cannot move without you.
  if is_pane_blocked "$pane_id" && ! is_shell_command "${command##*/}"; then PANE_STATE=waiting
  # Depth wins over the title: a lead that fanned out and went quiet reports an
  # idle title while its agents are still running, which is the case this exists for.
  elif (( AGENT_COUNT > 0 )); then PANE_STATE=active
  # Ahead of every title matcher: a working Claude pane's title is now
  # indistinguishable from an idle one, so the marker is the only truth.
  elif is_pane_busy "$pane_id"; then PANE_STATE=active
  elif has_spinner_title "$title" || is_active_title "$title"; then PANE_STATE=active
  elif is_waiting_title "$title"; then PANE_STATE=waiting
  elif is_codex_title "$title" || is_claude_title "$title" || is_llm_command "${command##*/}"; then PANE_STATE=present
  else PANE_STATE=none
  fi
}

# Scan a window's panes and echo four space-separated counts:
# "<active> <present> <waiting> <depth>" = working / present-but-idle /
# awaiting-input panes, then total subagents in flight across the window.
count_window() {
  local target="${1:?window target required}"
  local active=0 present=0 waiting=0 depth_sum=0 pane_id command title

  while IFS=$'\t' read -r pane_id command title; do
    classify_pane "$pane_id" "$command" "${title:-}"
    case "$PANE_STATE" in
      active) active=$((active + 1)); depth_sum=$((depth_sum + AGENT_COUNT)) ;;
      waiting) waiting=$((waiting + 1)) ;;
      present) present=$((present + 1)) ;;
    esac
  done < <(tmux_cmd list-panes -t "$target" -F '#{pane_id}	#{pane_current_command}	#{pane_title}' 2>/dev/null || true)

  # Trailing newline is required: callers use `read`, which returns non-zero at
  # EOF without one, and under `set -e` that would silently abort the caller.
  printf '%d %d %d %d\n' "$active" "$present" "$waiting" "$depth_sum"
}

# Per-window marker, by precedence: blocked (bang) > working (spinner) >
# present (diamond). The spinner's number is agents-in-flight when we have that
# count, else panes working - never the two summed, they are different units.
format_marker() {
  local active="$1" present="$2" waiting="$3" depth="${4:-0}" n

  if (( waiting > 0 )); then
    if (( waiting == 1 )); then printf '!'; else printf '!%d' "$waiting"; fi
  elif (( active > 0 )); then
    if (( depth > 0 )); then n="$depth"; else n="$active"; fi
    if (( n == 1 )); then spinner_frame; else printf '%s%d' "$(spinner_frame)" "$n"; fi
  elif (( present > 0 )); then
    if (( present == 1 )); then printf '◆'; else printf '◆%d' "$present"; fi
  fi
}

# The single category a window contributes to the fleet roll-up: its dominant
# marker, same precedence as format_marker.
window_category() {
  local active="$1" present="$2" waiting="$3"
  if (( waiting > 0 )); then printf 'waiting'
  elif (( active > 0 )); then printf 'active'
  elif (( present > 0 )); then printf 'present'
  else printf 'none'
  fi
}

# Compact roll-up across one session's windows: working, present, waiting (zeros
# omitted).
format_fleet() {
  local active_w="$1" present_w="$2" waiting_w="$3" out=''

  if (( active_w > 0 )); then out="${out}$(spinner_frame)${active_w} "; fi
  if (( present_w > 0 )); then out="${out}◆${present_w} "; fi
  if (( waiting_w > 0 )); then out="${out}!${waiting_w} "; fi

  printf '%s' "${out% }"
}

window_status() {
  local target="${1:?window target required}"
  local active present waiting depth
  read -r active present waiting depth < <(count_window "$target")
  format_marker "$active" "$present" "$waiting" "$depth"
}

# Roll-up for one session, defaulting to the current one. Falls back to every
# window only when run outside tmux, where there is no session to scope to.
fleet_summary() {
  local target="${1:-}"
  local window active present waiting depth
  local active_w=0 present_w=0 waiting_w=0
  local scope=(-a)

  [[ -n "$target" ]] || target="$(tmux_cmd display-message -p '#{session_id}' 2>/dev/null || true)"
  [[ -n "$target" ]] && scope=(-t "$target")

  while IFS= read -r window; do
    [[ -n "$window" ]] || continue
    read -r active present waiting depth < <(count_window "$window")
    case "$(window_category "$active" "$present" "$waiting")" in
      active) active_w=$((active_w + 1)) ;;
      present) present_w=$((present_w + 1)) ;;
      waiting) waiting_w=$((waiting_w + 1)) ;;
    esac
  done < <(tmux_cmd list-windows "${scope[@]}" -F '#{window_id}' 2>/dev/null || true)

  format_fleet "$active_w" "$present_w" "$waiting_w"
}

# Jump to the next window (after the current one, wrapping) blocked on you, or
# failing that, one with an agent present but not working.
next_waiting() {
  local current window active present waiting depth
  local windows=()

  current="$(tmux_cmd display-message -p '#{window_id}' 2>/dev/null || true)"
  while IFS= read -r window; do
    [[ -n "$window" ]] && windows+=("$window")
  done < <(tmux_cmd list-windows -a -F '#{window_id}' 2>/dev/null || true)

  local n=${#windows[@]}
  (( n > 0 )) || return 0

  local start=0 i
  for i in "${!windows[@]}"; do
    if [[ "${windows[$i]}" == "$current" ]]; then start=$i; break; fi
  done

  local off target pass
  # Blocked panes first; only when none are blocked, fall back to any idle agent.
  for pass in blocked idle; do
    for (( off = 1; off <= n; off++ )); do
      target="${windows[$(( (start + off) % n ))]}"
      read -r active present waiting depth < <(count_window "$target")
      case "$pass" in
        blocked) (( waiting > 0 )) || continue ;;
        idle) (( active == 0 && present > 0 )) || continue ;;
      esac
      tmux_cmd select-window -t "$target" 2>/dev/null \
        || tmux_cmd switch-client -t "$target" 2>/dev/null || true
      return 0
    done
  done

  tmux_cmd display-message 'No agents waiting on you' 2>/dev/null || true
}

# Refresh one session's windows and publish that session's roll-up. The roll-up
# is a SESSION option, not a global one: status-left renders it beside #S, so it
# has to describe that session. A single global value showed every session the
# same fleet-wide count, so a fresh session displayed another session's agents.
update_session() {
  local target="${1:?session target required}"
  local window active present waiting depth
  local active_w=0 present_w=0 waiting_w=0

  while IFS= read -r window; do
    [[ -n "$window" ]] || continue
    read -r active present waiting depth < <(count_window "$window")
    tmux_cmd set-option -wq -t "$window" @llm_status \
      "$(format_marker "$active" "$present" "$waiting" "$depth")" 2>/dev/null || true
    case "$(window_category "$active" "$present" "$waiting")" in
      active) active_w=$((active_w + 1)) ;;
      present) present_w=$((present_w + 1)) ;;
      waiting) waiting_w=$((waiting_w + 1)) ;;
    esac
  done < <(tmux_cmd list-windows -t "$target" -F '#{window_id}' 2>/dev/null || true)

  # Always set, even when empty: a session whose agents all finished must clear,
  # and an unset session option falls back to the global one.
  tmux_cmd set-option -q -t "$target" @llm_fleet \
    "$(format_fleet "$active_w" "$present_w" "$waiting_w")" 2>/dev/null || true
}

update_all_windows() {
  local session
  # Once per pass, so busy markers age against the current clock in the daemon's
  # long-lived process rather than against whenever it started.
  refresh_now

  # Clear the global fallback so a session created between passes renders empty
  # rather than inheriting whatever the last session to be scanned reported.
  tmux_cmd set-option -gqu @llm_fleet 2>/dev/null || true

  while IFS= read -r session; do
    [[ -n "$session" ]] || continue
    update_session "$session"
  done < <(tmux_cmd list-sessions -F '#{session_id}' 2>/dev/null || true)
}

run_daemon() {
  prune_dead_panes
  while true; do
    update_all_windows
    sleep 1
  done
}

pid_file() {
  printf '/tmp/tmux-llm-status-%s.pid' "${UID:-$(id -u)}"
}

start_daemon() {
  local pidfile pid
  pidfile="$(pid_file)"

  if [[ -f "$pidfile" ]]; then
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi

  nohup "$0" run >/dev/null 2>&1 &
  printf '%s\n' "$!" > "$pidfile"
}

stop_daemon() {
  local pidfile pid
  pidfile="$(pid_file)"
  pid="$(cat "$pidfile" 2>/dev/null || true)"

  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$pidfile"
}

# Row keys in order; q, r and t are taken by quit, refresh and the tree toggle.
TABLE_KEYS='123456789abcdefghijklmnopsuvwxyz'
TABLE_PANES=()

key_index() {
  local prefix="${TABLE_KEYS%%"$1"*}"
  if [[ -n "$1" && "$prefix" != "$TABLE_KEYS" ]]; then printf '%d' "${#prefix}"; fi
}

format_span() {
  local s="$1"
  if (( s < 60 )); then printf '%ds' "$s"
  elif (( s < 3600 )); then printf '%dm' $(( s / 60 ))
  elif (( s < 86400 )); then printf '%dh' $(( (s + 1800) / 3600 ))
  else printf '%dd' $(( (s + 43200) / 86400 )); fi
}

read_meta() {
  local file="$STATE_HOME/panes/${1#%}.meta"
  META_STAMP='' META_MODEL='' META_CTX='' META_5H='' META_5H_AT='' META_7D='' META_7D_AT='' META_BRANCH=''
  [[ -f "$file" ]] || return 0
  IFS=$'\x1f' read -r META_STAMP META_MODEL META_CTX META_5H META_5H_AT META_7D META_7D_AT META_BRANCH \
    < "$file" 2>/dev/null || true
}

# Tab-separated rows: rank, age, pane id, window name, state, agents, pane pid, path, session,
# tree key, title. Most urgent first, or with "tree" in choose-tree's session/window/pane order.
# The title stays last: tab is IFS whitespace, so an empty field mid-row would collapse.
collect_rows() {  # [tree]
  local pane_id pane_pid name activity command path session sid widx pidx title rank age
  local -a order=('-k1,1n' '-k2,2n')
  [[ "${1:-}" == tree ]] && order=('-k10,10n')
  refresh_now
  while IFS=$'\t' read -r pane_id pane_pid name activity command path session sid widx pidx title; do
    classify_pane "$pane_id" "$command" "${title:-}"
    case "$PANE_STATE" in
      waiting) rank=0 ;; active) rank=1 ;; present) rank=2 ;; *) continue ;;
    esac
    age=$(( NOW - ${activity:-$NOW} )); (( age >= 0 )) || age=0
    # choose-tree orders sessions by id (creation), then window and pane index.
    printf '%d\t%d\t%s\t%s\t%s\t%d\t%s\t%s\t%s\t%d\t%s\n' "$rank" "$age" "$pane_id" "$name" "$PANE_STATE" \
      "$AGENT_COUNT" "$pane_pid" "$path" "$session" $(( ${sid#\$} * 1000000 + widx * 1000 + pidx )) "${title:-}"
  done < <(tmux_cmd list-panes -a -F '#{pane_id}	#{pane_pid}	#{window_name}	#{window_activity}	#{pane_current_command}	#{pane_current_path}	#{session_name}	#{session_id}	#{window_index}	#{pane_index}	#{pane_title}' 2>/dev/null || true) \
    | sort -t "$(printf '\t')" "${order[@]}"
}

limit_part() {  # label pct reset_at
  [[ "$2" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0
  LC_NUMERIC=C printf '%s %.0f%%' "$1" "$2"
  if [[ -n "$3" ]] && (( $3 > NOW )); then printf ' (resets %s)' "$(format_span $(( $3 - NOW )))"; fi
}

# printf pads by byte, so a multibyte glyph such as · would shift every later column.
pad() {  # var text width
  local s="${2:0:$3}"
  printf -v "$1" '%s%*s' "$s" $(( $3 - ${#s} )) ''
}

# Window names repeat (one PJM per session), so only a repeated name carries its pane title.
target_label() {  # name title; counts against render_table's names
  local other n=0 task="${2#✳ }"
  for other in ${names[@]+"${names[@]}"}; do [[ "$other" == "$1" ]] && n=$((n + 1)); done
  if (( n > 1 )) && [[ -n "$task" ]]; then TARGET="$1 · $task"; else TARGET="$1"; fi
}

# The repo, not the worktree: a linked worktree's common dir is the main repo's .git,
# and BRANCH already names the worktree.
project_of() {
  local common
  common="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ "$common" == */.git ]]; then PROJECT="${common%/.git}"; else PROJECT="$1"; fi
  PROJECT="${PROJECT##*/}"
}

ORG_LOCK_BIN="${TMUX_LLM_ORG_LOCK:-org-lock}"

# Locks as "alias<TAB>pid<TAB>status"; returns 1 when org-lock or jq is missing or fails.
lock_rows() {
  local json
  command -v "$ORG_LOCK_BIN" >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 1
  json="$("$ORG_LOCK_BIN" list --json 2>/dev/null)" || return 1
  jq -r '.[] | [.alias, (.pid | tostring), .status] | @tsv' <<< "$json" 2>/dev/null || return 1
}

# Locks onto panes as "pane_id<TAB>alias<TAB>lock<TAB>pid", holders first; pane "-" when
# no pane owns the holder. org-lock records no waiters, so "queued" is inferred: a waiting
# process in one pane's tree while another tree holds that alias.
org_rows() {  # lock_rows output, "pane_id<TAB>pane_pid" lines
  [[ -n "$1" ]] || return 0
  # BSD-style `e` appends each process's environment, where an inline SF_ORG_ALIAS lives.
  # BSD awk rejects a newline inside -v, so the lines travel joined by ;.
  ps axeww -o pid=,ppid=,command= 2>/dev/null | awk -v locks="${1//$'\n'/;}" -v panes="${2//$'\n'/;}" '
    function pane_of(p,   hops) {
      for (hops = 0; hops < 32 && p > 1; hops++) { if (p in root) return root[p]; p = ppid[p] }
      return ""
    }
    function after(c, re, cut,   t) {
      if (!match(c, re)) return ""
      t = substr(c, RSTART, RLENGTH); sub(cut, "", t); return t
    }
    function waiter_alias(c,   a) {
      a = after(c, tool " run .*--alias [^ ]+", ".*--alias ")
      if (a == "") a = after(c, tool " claim [^ -][^ ]*", ".* claim ")
      if (a == "" && c ~ ("playwright" " test")) a = after(c, "SF_ORG" "_ALIAS=[^ ]+", "^[^=]*=")
      return a
    }
    BEGIN {
      # Split literals: this program is itself in the ps output and must not match itself.
      tool = "org" "-lock[^ ]*"
      n = split(panes, pl, ";")
      for (i = 1; i <= n; i++) { split(pl[i], f, "\t"); if (f[2] != "") root[f[2]] = f[1] }
      nl = split(locks, ll, ";")
    }
    { ppid[$1] = $2; c = $0; sub(/^ *[0-9]+ +[0-9]+ /, "", c); cmd[$1] = c }
    END {
      for (i = 1; i <= nl; i++) {
        if (split(ll[i], f, "\t") < 3) continue
        pn = pane_of(f[2]); owner[f[1]] = (pn == "" ? "-" : pn)
        # org-lock says live/unverified/stale; unverified is alive and mid-run, never free.
        lk = f[3] == "live" ? "held" : f[3] == "unverified" ? "held?" : f[3]
        print owner[f[1]] "\t" f[1] "\t" lk "\t" f[2]
      }
      for (p in cmd) {
        a = waiter_alias(cmd[p]); if (a == "" || !(a in owner)) continue
        pn = pane_of(p); if (pn == "" || pn == owner[a] || ((pn, a) in seen)) continue
        seen[pn, a] = 1; print pn "\t" a "\tqueued\t" p
      }
    }'
}

ANNOUNCE_LOG="${TMUX_LLM_ANNOUNCE_LOG:-/tmp/e2e-scratch-pool/announce.log}"
CLAUDE_SESSIONS="${TMUX_LLM_CLAUDE_SESSIONS:-$HOME/.claude/sessions}"

# Live Claude sessions as "pane_id<TAB>agent name" (pane "-" outside tmux), from the
# per-process records Claude keeps; a record whose pid is gone is a session that ended.
agent_panes() {
  local pid name pane
  command -v jq >/dev/null 2>&1 || return 0
  set -- "$CLAUDE_SESSIONS"/*.json
  [[ -e "$1" ]] || return 0
  { jq -r 'select(.name and .pid) | [(.pid | tostring), .name, ((.tmux // "-") | sub(".*[.]"; ""))] | @tsv' \
      "$@" 2>/dev/null || true; } | while IFS=$'\t' read -r pid name pane; do
    if kill -0 "$pid" 2>/dev/null; then printf '%s\t%s\n' "$pane" "$name"; fi
  done
}

# Sessions queue by logging WAIT, not by running a process, so the order lives in the
# announce log: "pane<TAB>alias<TAB>wait N<TAB>-", pane "-" plus session when none was logged,
# and "-<TAB>alias<TAB>free<TAB>count" for an unheld org. Tier first, then first WAIT.
# A line with no pane= finds its pane through the agent name the session logged; a
# hand-picked name finds none, which says nothing about whether that session is alive.
wait_rows() {  # org_rows output, live "pane_id<TAB>pane_pid" lines, agent_panes output
  [[ -r "$ANNOUNCE_LOG" ]] || return 0
  local cutoff
  # BSD date takes -v; GNU date (CI) wants -d.
  cutoff="$(date -v-12H +%FT%T 2>/dev/null || date -d '12 hours ago' +%FT%T 2>/dev/null)" || return 0
  tail -n 2000 "$ANNOUNCE_LOG" 2>/dev/null | awk -v held="${1//$'\n'/;}" -v panes="${2//$'\n'/;}" \
    -v cutoff="$cutoff" -v names="${3//$'\n'/;}" '
    BEGIN {
      # Sessions log their agent name, often without its two-character suffix.
      n = split(names, nl, ";")
      for (i = 1; i <= n; i++) {
        split(nl[i], f, "\t"); exact[f[2]] = f[1]; b = f[2]
        if (sub(/-[0-9a-f][0-9a-f]$/, "", b)) { base[b] = f[1]; nbase[b]++ }
      }
      n = split(panes, pl, ";"); for (i = 1; i <= n; i++) { split(pl[i], f, "\t"); live[f[1]] = 1 }
      n = split(held, hl, ";")
      for (i = 1; i <= n; i++) {
        split(hl[i], f, "\t")
        if (f[3] == "held" || f[3] == "held?") { holds[f[1], f[2]] = 1; taken[f[2]] = 1 }
      }
    }
    $2 !~ /^(CLAIM|WAIT|RELEASE|ACTUAL)$/ || NF < 4 { next }
    {
      pane = ""; tier = ""
      for (i = 5; i <= NF; i++) {
        if (pane == "" && $i ~ /^pane=%[0-9]+$/) pane = substr($i, 6)
        else if (tier == "" && $i ~ /^P[0-3]$/) tier = $i
      }
      # One open wait per session and alias; a later line naming either the pane or the
      # session is the same waiter. One silent past the cutoff was dead and keeps no place.
      k = ""
      for (j = 1; j <= nw; j++) if (open[j] && last[j] < cutoff) open[j] = 0
      for (j = 1; j <= nw; j++)
        if (open[j] && alias[j] == $3 && ((pane != "" && wpane[j] == pane) || sess[j] == $4)) { k = j; break }
      if ($2 != "WAIT") { if (k != "") open[k] = 0; next }
      if (k == "") { k = ++nw; open[k] = 1; alias[k] = $3; sess[k] = $4; since[k] = $1; rank[k] = 4 }
      if (pane != "") wpane[k] = pane
      if (tier != "") rank[k] = substr(tier, 2)
      last[k] = $1
    }
    END {
      for (j = 1; j <= nw; j++) {
        if (!open[j] || last[j] < cutoff) continue
        if (wpane[j] == "") {
          s = sess[j]
          if (s in exact) pn = exact[s]; else if (nbase[s] == 1) pn = base[s]; else pn = ""
          if (pn == "") why[j] = "unmatched"; else if (pn == "-") why[j] = "no pane"; else wpane[j] = pn
        }
        if (wpane[j] != "" && (!(wpane[j] in live) || ((wpane[j], alias[j]) in holds))) continue
        a = alias[j]; c = ++count[a]; q[a, c] = j
        if (c == 1) order[++na] = a
      }
      for (x = 1; x <= na; x++) {
        a = order[x]
        # Insertion sort: tier, then first WAIT, then log order. A queue is a handful of lines.
        for (i = 2; i <= count[a]; i++) {
          j = q[a, i]; key = rank[j] " " since[j]
          for (m = i - 1; m >= 1 && rank[q[a, m]] " " since[q[a, m]] > key; m--) q[a, m + 1] = q[a, m]
          q[a, m + 1] = j
        }
        if (!(a in taken)) print "-\t" a "\tfree\t" count[a]
        for (i = 1; i <= count[a]; i++) {
          j = q[a, i]
          if (wpane[j] != "") print wpane[j] "\t" a "\twait " i "\t-"
          else print "-\t" a "\twait " i "\t" sess[j] "\t" why[j]
        }
      }
    }'
}

# One pane's ORG and LOCK from org_rows; the first line wins, so held beats queued.
org_of() {
  local p a l
  ORG='-' LOCK='-'
  while IFS=$'\t' read -r p a l _; do
    if [[ "$p" == "$1" ]]; then ORG="$a" LOCK="$l"; return 0; fi
  done <<< "$ORG_ROWS"
}

# Inside $(...) tput sees neither stdout nor stderr as a terminal and answers 80, which
# squeezed TARGET to its floor in the popup; ask the controlling terminal directly.
term_cols() {
  local cols=''
  { read -r _ cols < <(stty size < /dev/tty); } 2>/dev/null || true
  if [[ "$cols" =~ ^[0-9]+$ ]] && (( cols > 0 )); then printf '%s' "$cols"; else printf 120; fi
}

render_table() {  # [tree]
  local mode="${1:-}" last_session=''
  local -a rows=() names=() targets=() projects=()
  local row rank age pane_id name state agents pane_pid path session tree title i=0 key label ctx
  local need=0 work=0 subs=0 newest=0 l5='' l5at='' l7='' l7at='' limits target_w=6 project_w=7 branch_w=6
  local locks org_w=0 lock_w=0 branch_pad=0 row_panes=' ' held p a l hp why locks_note='' all_panes waits
  local cols="${COLUMNS:-$(term_cols)}"
  TABLE_PANES=()
  refresh_now
  while IFS= read -r row; do rows+=("$row"); done < <(collect_rows "$mode")

  # bash 3.2: "${rows[@]}" on an empty array is unbound under set -u
  for row in ${rows[@]+"${rows[@]}"}; do
    IFS=$'\t' read -r rank age pane_id name state agents pane_pid path session tree title <<< "$row"
    names+=("$name")
    row_panes+="$pane_id "
    case "$state" in waiting) need=$((need + 1)) ;; active) work=$((work + 1)) ;; esac
    subs=$((subs + agents))
    read_meta "$pane_id"
    # Limits are account-wide, so the freshest reading from any pane wins.
    if [[ -n "$META_5H$META_7D" ]] && (( ${META_STAMP:-0} > newest )); then
      newest=$META_STAMP l5=$META_5H l5at=$META_5H_AT l7=$META_7D l7at=$META_7D_AT
    fi
  done

  # PROJECT and BRANCH fit their longest value (capped), so TARGET gets every other column
  # up to its own longest label, and rows never wrap.
  for row in ${rows[@]+"${rows[@]}"}; do
    IFS=$'\t' read -r rank age pane_id name state agents pane_pid path session tree title <<< "$row"
    target_label "$name" "$title"
    targets+=("$TARGET")
    (( ${#TARGET} <= target_w )) || target_w=${#TARGET}
    project_of "$path"
    projects+=("$PROJECT")
    (( ${#PROJECT} <= project_w )) || project_w=${#PROJECT}
    read_meta "$pane_id"
    (( ${#META_BRANCH} <= branch_w )) || branch_w=${#META_BRANCH}
  done
  (( project_w <= 22 )) || project_w=22
  (( branch_w <= 40 )) || branch_w=40

  # ORG and LOCK exist only while org-lock reports a lock or the log a wait: no idle pane
  # names its org.
  ORG_ROWS=''
  locks_known=1
  locks="$(lock_rows)" || locks_known=0
  if [[ -n "$locks" || -r "$ANNOUNCE_LOG" ]]; then
    all_panes="$(tmux_cmd list-panes -a -F '#{pane_id}	#{pane_pid}' 2>/dev/null || true)"
    [[ -z "$locks" ]] || ORG_ROWS="$(org_rows "$locks" "$all_panes")"
    waits="$(wait_rows "$ORG_ROWS" "$all_panes" "$(agent_panes)")"
    [[ -z "$waits" ]] || ORG_ROWS="${ORG_ROWS:+$ORG_ROWS$'\n'}$waits"
  fi
  if [[ -n "$ORG_ROWS" ]]; then
    org_w=3 lock_w=7 branch_pad=1
    while IFS=$'\t' read -r p a l hp why; do
      (( ${#a} <= org_w )) || org_w=${#a}
      # A holder or waiter with no agent row would be invisible, and it is the one that
      # surprises you.
      [[ "$l" == queued || "$row_panes" == *" $p "* ]] && continue
      # With no lock reading, "free" only means no holder was seen - the go-ahead a peer acts on.
      if [[ "$l" == free && "$locks_known" == 0 ]]; then held="$a lock unknown (org-lock unavailable), $hp waiting"
      elif [[ "$l" == free ]]; then held="$a free, $hp waiting"
      elif [[ "$l" == wait* && "$p" == - ]]; then held="$hp $l on $a ($why)"
      elif [[ "$l" == wait* ]]; then held="$a $l, in a non-agent pane"
      elif [[ "$l" == stale ]]; then held="$a stale, pid $hp gone"
      elif [[ "$p" == - ]]; then held="$a $l by pid $hp, not in a pane"
      else held="$a $l by pid $hp, in a non-agent pane"; fi
      locks_note="${locks_note:+$locks_note · }$held"
    done <<< "$ORG_ROWS"
    (( org_w <= 16 )) || org_w=16
  fi
  # 39 = KEY, STATE, AGE, AG, CTX, MODEL and the gaps between all nine columns.
  local fixed=$(( 39 + project_w + branch_w ))
  (( org_w == 0 )) || fixed=$(( fixed + 2 + org_w + lock_w ))
  # A long BRANCH gives width back, down to 16, before TARGET drops below 24.
  if (( cols - fixed < 24 && branch_w > 16 )); then
    local give=$(( 24 - (cols - fixed) ))
    (( give <= branch_w - 16 )) || give=$(( branch_w - 16 ))
    branch_w=$(( branch_w - give )) fixed=$(( fixed - give ))
  fi
  # BRANCH is padded only when ORG and LOCK follow it.
  (( branch_pad == 0 )) || branch_pad=$branch_w
  (( target_w <= cols - fixed )) || target_w=$(( cols - fixed ))
  (( target_w >= 12 )) || target_w=12

  printf 'LLM sessions · %d total · %d need you · %d working · %d subagents\n' \
    "${#rows[@]}" "$need" "$work" "$subs"
  if (( newest > 0 )); then
    limits="$(limit_part 5h "$l5" "$l5at")"
    [[ -n "$l7" ]] && limits="${limits:+$limits · }$(limit_part 7d "$l7" "$l7at")"
    # BSD date takes -r <epoch>; GNU date (CI) reads -r as a file and wants -d @<epoch>.
    printf 'Limits: %s · as of %s\n' "$limits" \
      "$(date -r "$newest" +%H:%M 2>/dev/null || date -d "@$newest" +%H:%M 2>/dev/null)"
  else
    printf 'Limits: no reading yet\n'
  fi
  [[ -z "$locks_note" ]] || printf 'Locks: %s\n' "$locks_note"
  printf '%-3s %-*s %-8s %4s %3s %4s %-9s %-*s %-*s' KEY "$target_w" TARGET STATE AGE AG CTX MODEL \
    "$project_w" PROJECT "$branch_pad" BRANCH
  (( org_w == 0 )) || printf ' %-*s LOCK' "$org_w" ORG
  printf '\n'

  for row in ${rows[@]+"${rows[@]}"}; do
    IFS=$'\t' read -r rank age pane_id name state agents pane_pid path session tree title <<< "$row"
    if [[ "$mode" == tree && "$session" != "$last_session" ]]; then
      # The same roll-up choose-tree and the status bar show for this session.
      printf '%s  %s\n' "$session" \
        "$(tmux_cmd show-options -qv -t "\$$(( tree / 1000000 ))" @llm_fleet 2>/dev/null || true)"
      last_session="$session"
    fi
    read_meta "$pane_id"
    pad TARGET "${targets[i]}" "$target_w"
    pad PROJECT "${projects[i]}" "$project_w"
    key="${TABLE_KEYS:i:1}"
    TABLE_PANES+=("$pane_id")
    case "$state" in waiting) label='! needs' ;; active) label='working' ;; *) label='idle' ;; esac
    # A corrupt reading must cost one cell, not the table: printf dies on non-numbers.
    ctx='-'; [[ "$META_CTX" =~ ^[0-9]+([.][0-9]+)?$ ]] && ctx="$(LC_NUMERIC=C printf '%.0f%%' "$META_CTX")"
    printf '%-3s %s %-8s %4s %3s %4s %-9.9s %s %-*.*s' \
      "${key:--}" "$TARGET" "$label" "$(format_span "$age")" "$agents" "$ctx" \
      "${META_MODEL:--}" "$PROJECT" "$branch_pad" "$branch_w" "${META_BRANCH:--}"
    if (( org_w > 0 )); then
      org_of "$pane_id"
      pad ORG "$ORG" "$org_w"
      printf ' %s %s' "$ORG" "$LOCK"
    fi
    printf '\n'
    i=$((i + 1))
  done
}

# switch-client alone lands on the window's active pane, not the one picked.
jump_to_pane() {
  tmux_cmd select-window -t "$1" 2>/dev/null || true
  tmux_cmd select-pane -t "$1" 2>/dev/null || true
  tmux_cmd switch-client -t "$1" 2>/dev/null || true
}

# Popup loop: draw once, then wait for a key; r redraws on demand, t flips to tree order.
pick() {
  local key idx rest mode=''
  while true; do
    printf '\033[H\033[2J'
    render_table "$mode"
    printf '\n[key] jump · t %s · r refresh · q quit\n' "$( [[ -n "$mode" ]] && echo 'urgency order' || echo 'tree order')"
    key=''
    # No timeout, so a failed read is EOF: piped stdin ran out or the popup closed.
    read -rsn1 key || return 0
    case "$key" in
      r) continue ;;
      t) if [[ -n "$mode" ]]; then mode=''; else mode=tree; fi; continue ;;
      q) return 0 ;;
      $'\e')
        # An arrow key is ESC plus a buffered tail; only a bare Esc (no tail within 1s) quits.
        rest=''
        read -rsn2 -t 1 rest || true
        [[ -n "$rest" ]] && continue
        return 0
        ;;
    esac
    idx="$(key_index "$key")"
    [[ -n "$idx" && -n "${TABLE_PANES[$idx]:-}" ]] || continue
    jump_to_pane "${TABLE_PANES[$idx]}"
    return 0
  done
}

case "${1:-}" in
  window)
    window_status "${2:-}"
    ;;
  summary)
    fleet_summary "${2:-}"
    ;;
  next-waiting)
    next_waiting
    ;;
  once)
    update_all_windows
    ;;
  prune)
    prune_dead_panes
    ;;
  table)
    render_table "${2:-}"
    ;;
  pick)
    pick
    ;;
  run)
    run_daemon
    ;;
  start)
    start_daemon
    ;;
  stop)
    stop_daemon
    ;;
  restart)
    stop_daemon
    start_daemon
    ;;
  *)
    printf 'Usage: %s window <target> | summary [session] | next-waiting | once | prune | table [tree] | pick | start | stop | restart\n' "${0##*/}" >&2
    exit 2
    ;;
esac
