#!/usr/bin/env bash
set -euo pipefail

tmux_cmd() {
  local default_socket
  default_socket="/private/tmp/tmux-$(id -u)/default"
  local tmux_bin="tmux"

  if [[ -x "/opt/homebrew/bin/tmux" ]]; then
    tmux_bin="/opt/homebrew/bin/tmux"
  elif [[ -x "/usr/local/bin/tmux" ]]; then
    tmux_bin="/usr/local/bin/tmux"
  fi

  if [[ -n "${TMUX_SOCKET:-}" ]]; then
    "$tmux_bin" -S "$TMUX_SOCKET" "$@"
  elif [[ -S "$default_socket" ]]; then
    "$tmux_bin" -S "$default_socket" "$@"
  else
    "$tmux_bin" "$@"
  fi
}

# LLM PRESENCE is detected from the terminal title (see the title helpers below
# and the classification order in count_window); WORKING is not, because Claude
# Code 2.1.2xx stopped animating its title - it now shows a static "✳ <summary>"
# whether it is thinking or idle, and ships no braille frames at all. Working
# state therefore comes from the hook-published busy marker (is_pane_busy); the
# title matchers survive only for Codex and any CLI that still animates.
# pane_current_command is an unstable value (Claude reports a version string such
# as "2.1.198", not "claude"), so presence is matched by title, not command. This
# list is only a fallback for CLIs that expose a stable process name. Do NOT add
# version strings here - fix the title matchers instead.
is_llm_command() {
  case "$1" in
    codex | claude | gemini | aider | opencode)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

STATE_HOME="${TMUX_LLM_STATE_HOME:-${HOME:-}/.local/state/tmux-llm}"

# How long a busy marker stays believable without a heartbeat. `Stop` does not
# fire when you interrupt a turn, so freshness - not mere existence - is what
# keeps an abandoned marker from spinning forever. The floor is the longest gap
# the hook can go without refreshing, i.e. one tool batch.
BUSY_TTL="${TMUX_LLM_BUSY_TTL:-1200}"

# Set once per pass and reused: this runs for every pane every second, so the
# alternative is a `date` fork per pane.
refresh_now() { NOW="$(date +%s)"; }

# Is a turn running in this pane? The marker holds the epoch of the last hook
# event in the turn. Read with a redirect rather than $(cat ...) to stay
# fork-free on the per-pane path.
is_pane_busy() {
  local file="$STATE_HOME/panes/${1#%}.busy" stamp=''
  [[ -f "$file" ]] || return 1
  [[ -n "${NOW:-}" ]] || refresh_now
  read -r stamp < "$file" 2>/dev/null || true
  [[ "$stamp" =~ ^[0-9]+$ ]] || return 1
  (( NOW - stamp < BUSY_TTL ))
}

# In-flight subagents for one pane, as a file count published by the
# tmux-agent-depth hook. Globbed rather than `ls`, and assigns into AGENT_COUNT
# rather than printing, because this runs for every pane on every one-second
# pass and must not fork - `$(...)` at the call site would fork just as surely
# as `ls` would.
count_agents() {
  local dir="$STATE_HOME/panes/${1#%}.agents"
  local -a found=("$dir"/*)
  if [[ -e "${found[0]}" ]]; then AGENT_COUNT=${#found[@]}; else AGENT_COUNT=0; fi
}

# Drop agent and busy state for panes tmux no longer reports. Pane ids reset to
# %0 on a tmux server restart, so stale state could otherwise collide with a
# recycled id.
prune_dead_panes() {
  local entry id live
  [[ -d "$STATE_HOME/panes" ]] || return 0
  live=" $(tmux_cmd list-panes -a -F '#{pane_id}' 2>/dev/null | tr -d '%' | tr '\n' ' ' || true)"
  # An empty live set more likely means the socket resolved wrong than that every
  # pane died at once - never let that wipe valid state.
  [[ "$live" != " " ]] || return 0
  for entry in "$STATE_HOME/panes"/*.agents "$STATE_HOME/panes"/*.busy; do
    [[ -e "$entry" ]] || continue
    id="${entry##*/}"
    id="${id%.agents}"
    id="${id%.busy}"
    case "$live" in
      *" $id "*) ;;
      *) rm -rf "$entry" 2>/dev/null || true ;;
    esac
  done
}

has_spinner_title() {
  case "$1" in
    # Braille spinner frames (U+2800-U+28FF). Claude Code animates the terminal
    # title with braille dots while actively working, and the classic dot
    # spinner lives in the same block. Matching the UTF-8 byte prefixes (E2 A0
    # through E2 A3) covers every frame without depending on which one is shown.
    $'\xe2\xa0'* | $'\xe2\xa1'* | $'\xe2\xa2'* | $'\xe2\xa3'*)
      return 0
      ;;
    # Circle / ASCII spinners (glyph followed by a space).
    "◐ "* | "◓ "* | "◑ "* | "◒ "* | "- "* | "\\ "* | "| "* | "/ "*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

spinner_frame() {
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  local index
  index=$(($(date +%s) % ${#frames[@]}))
  printf '%s' "${frames[$index]}"
}

is_codex_title() {
  [[ "$1" == \[*\]\ *\|* ]]
}

is_claude_title() {
  # Claude Code shows a static "✳ " prefix (U+2733) while present but idle /
  # awaiting input. The animated braille frames (handled by has_spinner_title)
  # cover the actively-working state.
  case "$1" in
    "✳ "* | "✳"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_waiting_title() {
  case "$1" in
    *"Action Required"* | *"Ready"* | *"Idle"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_active_title() {
  case "$1" in
    *"Thinking"* | *"Working"* | *"Running"* | *"Processing"* | *"Executing"* | *"Loading"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# Scan a window's panes and echo four space-separated counts:
# "<active> <present> <waiting> <depth>" = working / present-but-idle /
# awaiting-input panes, then total subagents in flight across the window.
count_window() {
  local target="${1:?window target required}"
  local active=0 present=0 waiting=0 depth_sum=0 pane_id command title depth

  while IFS=$'\t' read -r pane_id command title; do
    count_agents "$pane_id"
    depth=$AGENT_COUNT
    # Depth wins over the title: a lead that fanned out and went quiet reports an
    # idle title while its agents are still running, which is the case this exists for.
    if (( depth > 0 )); then
      active=$((active + 1))
      depth_sum=$((depth_sum + depth))
    # Ahead of every title matcher: a working Claude pane's title is now
    # indistinguishable from an idle one, so the marker is the only truth.
    elif is_pane_busy "$pane_id"; then
      active=$((active + 1))
    elif has_spinner_title "${title:-}"; then
      active=$((active + 1))
    elif is_active_title "${title:-}"; then
      active=$((active + 1))
    elif is_waiting_title "${title:-}"; then
      waiting=$((waiting + 1))
    elif is_codex_title "${title:-}"; then
      present=$((present + 1))
    elif is_claude_title "${title:-}"; then
      present=$((present + 1))
    elif is_llm_command "${command##*/}"; then
      present=$((present + 1))
    fi
  done < <(tmux_cmd list-panes -t "$target" -F '#{pane_id}	#{pane_current_command}	#{pane_title}' 2>/dev/null || true)

  # Trailing newline is required: callers use `read`, which returns non-zero at
  # EOF without one, and under `set -e` that would silently abort the caller.
  printf '%d %d %d %d\n' "$active" "$present" "$waiting" "$depth_sum"
}

# Per-window marker, by precedence: working (spinner) > present (diamond) >
# waiting (bang). The spinner's number is agents-in-flight when we have that
# count, else panes working - never the two summed, they are different units.
format_marker() {
  local active="$1" present="$2" waiting="$3" depth="${4:-0}" n

  if (( active > 0 )); then
    if (( depth > 0 )); then n="$depth"; else n="$active"; fi
    if (( n == 1 )); then spinner_frame; else printf '%s%d' "$(spinner_frame)" "$n"; fi
  elif (( present > 0 )); then
    if (( present == 1 )); then printf '◆'; else printf '◆%d' "$present"; fi
  elif (( waiting > 0 )); then
    if (( waiting == 1 )); then printf '!'; else printf '!%d' "$waiting"; fi
  fi
}

# The single category a window contributes to the fleet roll-up: its dominant
# marker, same precedence as format_marker.
window_category() {
  local active="$1" present="$2" waiting="$3"
  if (( active > 0 )); then printf 'active'
  elif (( present > 0 )); then printf 'present'
  elif (( waiting > 0 )); then printf 'waiting'
  else printf 'none'
  fi
}

# Compact roll-up across one session's windows: working, present, waiting (zeros
# omitted).
format_fleet() {
  local active_w="$1" present_w="$2" waiting_w="$3" out=''

  if (( active_w > 0 )); then out="${out}$(spinner_frame)${active_w} "; fi
  if (( present_w > 0 )); then out="${out}◆${present_w} "; fi
  if (( waiting_w > 0 )); then out="${out}!${waiting_w} "; fi

  printf '%s' "${out% }"
}

window_status() {
  local target="${1:?window target required}"
  local active present waiting depth
  read -r active present waiting depth < <(count_window "$target")
  format_marker "$active" "$present" "$waiting" "$depth"
}

# Roll-up for one session, defaulting to the current one. Falls back to every
# window only when run outside tmux, where there is no session to scope to.
fleet_summary() {
  local target="${1:-}"
  local window active present waiting depth
  local active_w=0 present_w=0 waiting_w=0
  local scope=(-a)

  [[ -n "$target" ]] || target="$(tmux_cmd display-message -p '#{session_id}' 2>/dev/null || true)"
  [[ -n "$target" ]] && scope=(-t "$target")

  while IFS= read -r window; do
    [[ -n "$window" ]] || continue
    read -r active present waiting depth < <(count_window "$window")
    case "$(window_category "$active" "$present" "$waiting")" in
      active) active_w=$((active_w + 1)) ;;
      present) present_w=$((present_w + 1)) ;;
      waiting) waiting_w=$((waiting_w + 1)) ;;
    esac
  done < <(tmux_cmd list-windows "${scope[@]}" -F '#{window_id}' 2>/dev/null || true)

  format_fleet "$active_w" "$present_w" "$waiting_w"
}

# Jump to the next window (after the current one, wrapping) that has an agent
# present but NOT actively working - i.e. one likely waiting on your reply.
next_waiting() {
  local current window active present waiting depth
  local windows=()

  current="$(tmux_cmd display-message -p '#{window_id}' 2>/dev/null || true)"
  while IFS= read -r window; do
    [[ -n "$window" ]] && windows+=("$window")
  done < <(tmux_cmd list-windows -a -F '#{window_id}' 2>/dev/null || true)

  local n=${#windows[@]}
  (( n > 0 )) || return 0

  local start=0 i
  for i in "${!windows[@]}"; do
    if [[ "${windows[$i]}" == "$current" ]]; then start=$i; break; fi
  done

  local off target
  for (( off = 1; off <= n; off++ )); do
    target="${windows[$(( (start + off) % n ))]}"
    read -r active present waiting depth < <(count_window "$target")
    if (( active == 0 )) && (( present > 0 || waiting > 0 )); then
      tmux_cmd select-window -t "$target" 2>/dev/null \
        || tmux_cmd switch-client -t "$target" 2>/dev/null || true
      return 0
    fi
  done

  tmux_cmd display-message 'No agents waiting on you' 2>/dev/null || true
}

# Refresh one session's windows and publish that session's roll-up. The roll-up
# is a SESSION option, not a global one: status-left renders it beside #S, so it
# has to describe that session. A single global value showed every session the
# same fleet-wide count, so a fresh session displayed another session's agents.
update_session() {
  local target="${1:?session target required}"
  local window active present waiting depth
  local active_w=0 present_w=0 waiting_w=0

  while IFS= read -r window; do
    [[ -n "$window" ]] || continue
    read -r active present waiting depth < <(count_window "$window")
    tmux_cmd set-option -wq -t "$window" @llm_status \
      "$(format_marker "$active" "$present" "$waiting" "$depth")" 2>/dev/null || true
    case "$(window_category "$active" "$present" "$waiting")" in
      active) active_w=$((active_w + 1)) ;;
      present) present_w=$((present_w + 1)) ;;
      waiting) waiting_w=$((waiting_w + 1)) ;;
    esac
  done < <(tmux_cmd list-windows -t "$target" -F '#{window_id}' 2>/dev/null || true)

  # Always set, even when empty: a session whose agents all finished must clear,
  # and an unset session option falls back to the global one.
  tmux_cmd set-option -q -t "$target" @llm_fleet \
    "$(format_fleet "$active_w" "$present_w" "$waiting_w")" 2>/dev/null || true
}

update_all_windows() {
  local session
  # Once per pass, so busy markers age against the current clock in the daemon's
  # long-lived process rather than against whenever it started.
  refresh_now

  # Clear the global fallback so a session created between passes renders empty
  # rather than inheriting whatever the last session to be scanned reported.
  tmux_cmd set-option -gqu @llm_fleet 2>/dev/null || true

  while IFS= read -r session; do
    [[ -n "$session" ]] || continue
    update_session "$session"
  done < <(tmux_cmd list-sessions -F '#{session_id}' 2>/dev/null || true)
}

run_daemon() {
  prune_dead_panes
  while true; do
    update_all_windows
    sleep 1
  done
}

pid_file() {
  printf '/tmp/tmux-llm-status-%s.pid' "${UID:-$(id -u)}"
}

start_daemon() {
  local pidfile pid
  pidfile="$(pid_file)"

  if [[ -f "$pidfile" ]]; then
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi

  nohup "$0" run >/dev/null 2>&1 &
  printf '%s\n' "$!" > "$pidfile"
}

stop_daemon() {
  local pidfile pid
  pidfile="$(pid_file)"
  pid="$(cat "$pidfile" 2>/dev/null || true)"

  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$pidfile"
}

case "${1:-}" in
  window)
    window_status "${2:-}"
    ;;
  summary)
    fleet_summary "${2:-}"
    ;;
  next-waiting)
    next_waiting
    ;;
  once)
    update_all_windows
    ;;
  prune)
    prune_dead_panes
    ;;
  run)
    run_daemon
    ;;
  start)
    start_daemon
    ;;
  stop)
    stop_daemon
    ;;
  restart)
    stop_daemon
    start_daemon
    ;;
  *)
    printf 'Usage: %s window <target> | summary [session] | next-waiting | once | prune | start | stop | restart\n' "${0##*/}" >&2
    exit 2
    ;;
esac
